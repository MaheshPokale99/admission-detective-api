# --- Gemini (required for the Detective agent) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that supports function calling.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Email (optional) ---
# Provider is picked automatically: SMTP if SMTP_HOST is set, else Resend if RESEND_API_KEY is set,
# else "simulated" (recorded and marked sent, nothing is delivered).
# Force one with EMAIL_PROVIDER=smtp | resend | simulated.
EMAIL_PROVIDER=

# SMTP works with any mailbox, no domain needed. Gmail example (use an App Password, not your login password):
#   Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave empty: 465 uses implicit TLS, 587 uses STARTTLS.
SMTP_SECURE=
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_app_password

# Resend needs a verified domain to email anyone but yourself.
RESEND_API_KEY=

# Sender shown to students. With SMTP this defaults to "NIAT Admissions <SMTP_USER>".
# Gmail and most providers rewrite it to the authenticated mailbox anyway.
EMAIL_FROM=

# --- Database (PostgreSQL on Supabase) ---
# One URL is enough: the Supabase session-mode pooler (port 5432) serves both the app and the migrations.
# Replace [YOUR-PASSWORD]. If it has special characters (@ : / # ?), URL-encode them.
DATABASE_URL="postgresql://postgres.fifwxcfsmmyqcenqkwxh:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# Supabase requires TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=5

# Local alternatives (comment out the Supabase URLs above and set DATABASE_SSL=false):
#   Docker:    docker compose up -d db          DATABASE_URL=postgresql://postgres:postgres@localhost:5432/detective
#   No Docker: npm run db:local                 (same URL, zero-install Postgres via PGlite)

# --- Server ---
# development | test | production. Production turns off demo seeding and the reset endpoint by default.
NODE_ENV=development
PORT=5000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Also append every log line to this file as JSON (the console output stays on). Leave empty for console only.
LOG_FILE=logs/app.log
# Allowed browser origin(s) for CORS, comma separated. Must match where the frontend runs.
FRONTEND_ORIGIN=http://localhost:3000

# --- Rate limits (per client address, per minute) ---
RATE_LIMIT_PER_MINUTE=300
# Stricter limit on the Gemini investigation endpoint.
INVESTIGATE_RATE_LIMIT_PER_MINUTE=10
# Set true behind a reverse proxy so the client address is read from X-Forwarded-For.
TRUST_PROXY=false

# --- Demo mode (leave empty: both default to on outside production) ---
# Exposes POST /api/v1/admin/reset, which wipes the data and reloads the sample leads.
ENABLE_DEMO_ENDPOINTS=
# Loads the sample leads when the database is empty on start-up.
SEED_ON_EMPTY=

# --- Business rules ---
# A lead with no activity for this many days is considered stalled.
STALL_THRESHOLD_DAYS=5
# Minimum days between two outreach messages to the same lead.
CONTACT_COOLDOWN_DAYS=3
