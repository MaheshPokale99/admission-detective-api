{
    "name": "admission-detective-backend",
    "version": "1.0.0",
    "description": "Admission Drop-Off Detective - Gemini agent API",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
        "postinstall": "prisma generate",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "db:migrate:dev": "prisma migrate dev",
        "db:studio": "prisma studio",
        "db:local": "tsx scripts/dev-db.ts",
        "db:seed": "tsx scripts/seed.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build": "tsc -p tsconfig.build.json",
        "start:dev": "tsx src/server.ts",
        "knip": "knip"
    },
    "type": "module",
    "dependencies": {
        "@google/genai": "^2.29.1",
        "@hono/node-server": "^2.1.5",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "dotenv": "^18.0.7",
        "hono": "^4.13.13",
        "nodemailer": "^10.1.1",
        "pino": "^10.4.0",
        "prisma": "^7.10.0",
        "resend": "^6.32.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.9",
        "@electric-sql/pglite-socket": "^0.2.12",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@types/smtp-server": "^3.5.13",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "knip": "^6.41.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "smtp-server": "^3.19.21",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.71.2"
    },
    "private": true,
    "engines": {
        "node": ">=22.13"
    }
}
